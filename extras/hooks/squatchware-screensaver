#!/bin/bash
# Omarchy theme-set hook from Squatchware. While a theme that ships a screensaver.txt is active
# (the Squatchware themes, the Retro Pack), the screensaver uses that theme's art; switch to
# a theme without one and your own art comes back. Omarchy passes the new theme's name as $1.
# Every Squatchware theme installs this same file, so there's only ever one of it.

branding=~/.config/omarchy/branding/screensaver.txt
saved=~/.config/omarchy/branding/screensaver.pre-squatchware.txt
art=~/.config/omarchy/themes/${1:-}/screensaver.txt

if [[ -n ${1:-} && -f $art ]]; then
  [[ -f $saved ]] || cp "$branding" "$saved" 2>/dev/null
  cp "$art" "$branding"
elif [[ -f $saved ]]; then
  mv "$saved" "$branding"
fi
exit 0
